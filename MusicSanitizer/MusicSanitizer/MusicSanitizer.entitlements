<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Sandbox is OFF on purpose.

      Tag writing shells out to Homebrew ffmpeg/ffprobe
      (/opt/homebrew/bin or /usr/local/bin). A sandboxed app cannot
      see or execute those binaries, which produced:
      "Tag write failed: ffmpeg not found" even when ffmpeg was installed.

      This is a personal library utility that already requires full access
      to a user-chosen music folder, so sandboxing adds little protection
      while breaking the core feature.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Hardened Runtime: allow spawning the Homebrew ffmpeg child process -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
